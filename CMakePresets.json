{
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "STRING",
          "value": "Debug"
        }
      },
      "errors": {
        "deprecated": true
      },
      "hidden": true,
      "name": "cmake-dev",
      "warnings": {
        "deprecated": true,
        "dev": true
      }
    },
    {
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_OVERLAY_PORTS": {
          "type": "STRING",
          "value": "${sourceDir}/cmake/ports"
        },
        "VCPKG_OVERLAY_TRIPLETS": {
          "type": "STRING",
          "value": "${sourceDir}/cmake/triplets"
        }
      },
      "hidden": true,
      "name": "vcpkg"
    },
    {
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": {
          "type": "STRING",
          "value": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-windows-static-md"
        }
      },
      "hidden": true,
      "name": "msvc"
    },
    {
      "cacheVariables": {
        "ENABLE_SKYRIM_SE": {
          "type": "BOOL",
          "value": "ON"
        },
        "ENABLE_SKYRIM_AE": {
          "type": "BOOL",
          "value": "ON"
        },
        "ENABLE_SKYRIM_VR": {
          "type": "BOOL",
          "value": "ON"
        }
      },
      "hidden": true,
      "name": "skyrim-runtimes"
    },
    {
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP /W4",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "generator": "Ninja Multi-Config",
      "inherits": ["cmake-dev", "vcpkg", "msvc", "skyrim-runtimes"],
      "name": "msvc-windows"
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC-Debug",
      "configurePreset": "msvc-windows",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC-Release",
      "configurePreset": "msvc-windows",
      "configuration": "Release"
    }
  ],
  "version": 3
